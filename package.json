{
  "name": "security-audit-mcp-ver",
  "version": "0.3.0",
  "private": false,
  "description": "Read-only, evidence-led source security audit tools exposed through MCP.",
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run test:unit && npm run test:upstream",
    "test:unit": "tsx --test src/audit/contracts.test.ts src/audit/upstream.test.ts src/audit/reconnaissance.test.ts src/audit/hunting.test.ts",
    "test:upstream": "node --test vendor/cloudflare-security-audit-skill/validate-coverage-ledger.test.cjs vendor/cloudflare-security-audit-skill/validate-findings.test.cjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "tsx": "^4.19.4",
    "typescript": "^5.9.3"
  },
  "license": "AGPL-3.0-or-later"
}
